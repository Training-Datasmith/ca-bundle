{
    "name": "composer/ca-bundle",
    "description": "Lets you find a path to the system CA bundle, and includes a fallback to the Mozilla CA bundle.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "cabundle",
        "cacert",
        "certificate",
        "ssl",
        "tls"
    ],
    "authors": [
        {
            "name": "Jordi Boggiano",
            "email": "j.boggiano@seld.be",
            "homepage": "http://seld.be"
        }
    ],
    "support": {
        "irc": "irc://irc.freenode.org/composer",
        "issues": "https://github.com/composer/ca-bundle/issues"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://raw.githubusercontent.com/Training-Datasmith/composer-index/remote-test-2026-11-09",
            "canonical": false
        }
    ],
    "require": {
        "ext-openssl": "*",
        "ext-pcre": "*",
        "php": "^7.2 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.5.52",
        "phpstan/phpstan": "^1.10",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "symfony/process": "^4.0 || ^5.0 || ^6.0 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "Composer\\Ca_Bundle\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Composer\\Ca_Bundle\\": "tests"
        }
    },
    "config": {
        "lock": false,
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "scripts": {
        "test": [
            "@php vendor/bin/phpunit --colors=never --no-coverage",
            "@php scripts/check-cluster-pins.php",
            "@php scripts/check-rename.php"
        ],
        "phpstan": "@php vendor/bin/phpstan analyse --no-progress --no-ansi --memory-limit=1G",
        "lint": "bash scripts/lint-src.sh",
        "pins": "@php scripts/check-cluster-pins.php"
    }
}
